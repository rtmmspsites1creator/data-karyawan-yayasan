rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validEmployee(d) {
      return d.keys().hasOnly(['nama', 'nik', 'yayasan', 'tanggalMasuk', 'createdAt'])
        && d.keys().hasAll(['nama', 'nik', 'yayasan', 'tanggalMasuk', 'createdAt'])
        && d.nama is string && d.nama.size() > 0 && d.nama.size() <= 100
        && d.nik is string && d.nik.size() > 0 && d.nik.size() <= 30
        && d.yayasan is string && d.yayasan.size() > 0 && d.yayasan.size() <= 100
        && d.tanggalMasuk is string
        && d.tanggalMasuk.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.createdAt == request.time;
    }

    match /employees/{employeeId} {
      allow create: if validEmployee(request.resource.data);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /admins/{uid} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
